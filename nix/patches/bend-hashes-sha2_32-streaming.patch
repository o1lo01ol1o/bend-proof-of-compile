+# One round per constant; the window slides by the schedule's next word.
+def SHA2_32.rounds(ks: List<&2, U32>, st: S256, window: W16) -> S256:
+  match ks window:
+    case Nil{} +unused_window:
       st
+    case k <> kt W16{+w0, +w1, w2, w3, w4, w5, w6, w7, w8, +w9, w10, w11, w12, w13, +w14, w15}:
+      SHA2_32.rounds(
+        kt,
+        SHA2_32.step(st, w0, k),
+        W16{
+          w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15,
+          U32.add(U32.add(SHA2_32.small1(w14), w9), U32.add(SHA2_32.small0(w1), w0))
+        }
+      )
 
