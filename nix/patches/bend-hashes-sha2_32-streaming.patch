 # SHA-224 / SHA-256
 # =================
+#
+# Streaming form: the message is read as big-endian words four bytes at a
+# time, and the schedule is a sixteen-word window that slides one word per
+# round, so a block costs a constant number of steps (no indexed list reads,
+# no list rebuilding per word). Rotations use constant shifts. Long messages
+# are built and read by tail calls only.
 
 type S256 is Data:
   S256{a: U32, b: U32, c: U32, d: U32, e: U32, f: U32, g: U32, h: U32}
 
+# The schedule's last sixteen words, oldest first.
+type W16 is Data:
+  W16{
+    w0: U32, w1: U32, w2: U32, w3: U32, w4: U32, w5: U32, w6: U32, w7: U32,
+    w8: U32, w9: U32, w10: U32, w11: U32, w12: U32, w13: U32, w14: U32, w15: U32
+  }
+
+# Right rotation by n, given m = 32 - n.
+def SHA2_32.rotr(+x: U32, +n: Nat, +m: Nat) -> U32:
+  U32.or(U32.shrn(x, n), U32.shln(x, m))
