+def SHA2_32.pad(+n: Nat) -> List<&2, U32>:
+  128 <> List.append(
+    &2,
+    U32,
+    List.replicate(U32, SHA2_32.pad.zeros(Nat.mod(n, 64n), Nat.is_le(Nat.mod(n, 64n), 55n)), 0),
+    C.Bytes.u32be(
+      U32.from_nat(Nat.div(n, 536870912n)),
+      C.Bytes.u32be(U32.shln(U32.from_nat(n), 3n), Nil{})
+    )
+  )
+
+# `latest` (the message, latest byte first) reversed onto the padding.
+def SHA2_32.onto(latest: List<&2, U32>, tail: List<&2, U32>) -> List<&2, U32>:
+  match latest:
+    case Nil{}:
+      tail
+    case byte <> rest:
+      SHA2_32.onto(rest, byte <> tail)
+
+def SHA2_32.run.at(+n: Nat, latest: List<&2, U32>, iv: S256) -> S256:
+  SHA2_32.blocks(
+    Nat.div(Nat.add(n, 72n), 64n),
+    SHA2_32.load(16n, SHA2_32.onto(latest, SHA2_32.pad(n)), Nil{}),
+    iv
+  )
+
+# The final state of a message given latest byte first.
+def SHA2_32.run(+latest: List<&2, U32>, iv: S256) -> S256:
+  SHA2_32.run.at(C.Bytes.length_nat(latest), latest, iv)
+
+# UTF-8 of a string, latest byte first.
+def SHA2_32.utf8(s: String, acc: List<&2, U32>) -> List<&2, U32>:
+  match s:
+    case SNil{}:
+      acc
+    case SCon{head, tail}:
+      SHA2_32.utf8(tail, C.Bytes.utf8.rev.code(Char.to_u32(head), acc))
 
